# Run: python scripts/setup_local.py --demo (from the repository root).
# This example is documentation; do not copy a shared signing secret.
DATABASE_URL=sqlite:///./dice-local.db
DEMO_MODE=false
# SECRET_KEY is generated once by setup_local.py and stored only in ignored .env.

# Optional Stripe PromptPay checkout. See docs/STRIPE_PROMPTPAY.md.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGIN=
